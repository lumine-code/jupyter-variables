{
  "name": "jupyter-variables",
  "author": "lumine-code",
  "description": "Browse and edit a Jupyter kernel's namespace in a table.",
  "repository": "https://github.com/lumine-code/jupyter-variables",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-variables/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-variables#readme",
  "keywords": [
    "namespace",
    "workspace",
    "globals",
    "inspect",
    "pandas",
    "numpy",
    "python"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can browse everything the kernel has in memory with {{ 'jupyter-variables:toggle-focus' | keystroke }}"
  ],
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "activationCommands": {
    "lumine-workspace": [
      "jupyter-variables:toggle",
      "jupyter-variables:toggle-focus",
      "jupyter-variables:refresh"
    ]
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    },
    "jupyter.explorer": {
      "versions": {
        "^1.0.0": "consumeJupyterExplorer"
      }
    },
    "jupyter.output": {
      "versions": {
        "^1.0.0": "consumeJupyterOutput"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#ad65d4e2a81aa70839069309fa532635bc007b7e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
